
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ROS 2: Build workspace",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "source /opt/ros/jazzy/setup.bash && colcon build --symlink-install"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Gazebo: Open shapes demo",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "source /opt/ros/jazzy/setup.bash && gz sim shapes.sdf"
      ],
      "problemMatcher": []
    },
    {
      "label": "ROS 2: List active topics",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "source /opt/ros/jazzy/setup.bash && source install/setup.bash && ros2 topic list"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}